#!/usr/bin/env bash
# Amp orb setup for corinth-canal.
#
# Amp runs this from the repository root when it builds a project orb snapshot
# (Debian 12, CPU only: orbs have no GPU). It must finish within 20 minutes and
# be safe to run more than once. See https://ampcode.com/docs/orbs/customizing
#
# Installs only what this repo's CI and manifests need:
#   - apt: build-essential, pkg-config, libssl-dev
#   - Rust stable (+rustfmt, clippy, llvm-tools-preview) [default]
#   - uv + Python 3.11 venv with ruff==0.15.14 (benchmarks lint)
#   - cargo fetch --locked
#
# It ends with a dependency fetch/prebuild, not a test run.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  SUDO="sudo"
fi

# Install Debian packages that are not already present.
apt_install() {
  local missing=() pkg
  for pkg in "$@"; do
    if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed"; then
      missing+=("$pkg")
    fi
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    $SUDO apt-get -o Acquire::Retries=5 update -qq
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends "${missing[@]}"
  fi
}

# --- System packages (C toolchain for build.rs (cc); libssl-dev for openssl-sys) ---
apt_install build-essential pkg-config libssl-dev

# --- Rust (rustup) ---
export PATH="$HOME/.cargo/bin:$PATH"
if ! command -v rustup >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
    sh -s -- -y --default-toolchain none --profile minimal
fi
# ci.yml uses stable + rustfmt, clippy, llvm-tools-preview.
rustup toolchain install stable --profile minimal --component rustfmt --component clippy --component llvm-tools-preview
rustup default stable

# --- Python (uv) ---
export PATH="$HOME/.local/bin:$PATH"
if ! command -v uv >/dev/null 2>&1; then
  curl -LsSf https://astral.sh/uv/install.sh | sh
fi
# ci.yml benchmarks step uses Python 3.11.
uv python install 3.11
if [ ! -x .venv/bin/python ]; then
  uv venv --python 3.11 .venv
fi
uv pip install --python .venv/bin/python 'ruff==0.15.14'

# --- Prefetch crates (no build, no tests) ---
# Fetching is feature-independent; build/test with --no-default-features (default feature `cuda` needs nvcc).
cargo fetch --locked

echo "Amp orb setup for corinth-canal finished."
