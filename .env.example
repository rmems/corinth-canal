# corinth-canal example runtime configuration
#
# Copy this file to `.env.local` and fill in machine-specific paths.
# `.env.local` is gitignored and auto-loaded by the example binaries via
# `dotenvy::from_filename(".env.local")`.
#
# Leave a key blank (or delete its line) to use the compiled-in default.

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Optional Sentry DSN. Leave blank to keep examples fully local/offline:
# no Sentry client is initialized, no network dependency is introduced,
# and runs do not fail just because Sentry is unavailable.
SENTRY_DSN=

# Optional Sentry environment tag. Defaults to `local`.
SENTRY_ENVIRONMENT=local

# Optional explicit Sentry release. When blank, the example wrappers fall back
# to `corinth-canal@<git_sha>` first and only use `sentry::release_name!()`
# when no git SHA can be resolved in the current checkout.
SENTRY_RELEASE=

# Optional externally supplied command-level run ID for example wrappers.
# When blank, wrappers generate `corinth-canal-<millis>`.
AGENTOS_RUN_ID=

# Optional externally supplied git SHA for traces / Sentry tags. When blank,
# wrappers fall back to `git rev-parse --short HEAD`.
AGENTOS_GIT_SHA=

# Set to `1` to emit JSON tracing from the example wrappers.
AGENTOS_JSON_TRACING=0

# ---------------------------------------------------------------------------
# New Relic OpenTelemetry telemetry
# ---------------------------------------------------------------------------

# New Relic ingest license key. When set, `init_tracing()` automatically
# wires a `tracing-opentelemetry` layer that exports spans to New Relic via
# OTLP/HTTP. Leave blank to keep examples fully local/offline.
NR_INSERT_KEY=

# Optional generic New Relic OTLP endpoint. The OpenTelemetry SDK appends the
# signal path when this base endpoint is used. Defaults to New Relic's trace
# endpoint when both OTLP endpoint vars are blank.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional trace-specific OTLP endpoint. Use this when passing a full traces URL.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Optional OpenTelemetry service name. Defaults to `corinth-canal`.
OTEL_SERVICE_NAME=

# Optional New Relic account ID. Used by the NR verification helpers in
# examples/support/observability.rs; not required for OTLP export itself.
NR_ACCOUNT_ID=

# Optional New Relic query key. Used by verification helpers only.
NR_QUERY_KEY=

# Optional New Relic app name. Used by verification helpers only.
NEW_RELIC_APP_NAME=

# ---------------------------------------------------------------------------
# Model root configuration
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Checkpoint + embedding tooling
# ---------------------------------------------------------------------------

# Absolute path to a checkpoint (GGUF file or safetensors directory). When set,
# overrides model auto-discovery. When unset, saaq_latent_calibration falls back
# to scanning $HOME/Downloads/SNN_Quantization for validated MoE families.
CHECKPOINT_PATH=

# Absolute path to a safetensors lineup TOML file (see
# configs/local_safetensors_lineup.template.toml). When set, loads safetensors models
# for local SAAQ experiments. Takes precedence over CHECKPOINT_PATH when both
# are set.
SAFETENSORS_LINEUP_CONFIG=


# Prompt embedding provider. Only two outcomes exist
# (examples/support/embedding.rs::resolve_prompt_embedding_provider):
#   "ollama" (or unset) -> Ollama over HTTP, see OLLAMA_EMBED_* below
#   any other value     -> deterministic synthetic text-hash fallback
#
# NOTE: unset means Ollama, so a run with no value set still depends on
# a reachable OLLAMA_EMBED_URL. Set it to e.g. "synthetic" to stay offline.
EMBEDDING_PROVIDER=ollama

# Ollama embedding settings. Only consulted when EMBEDDING_PROVIDER resolves
# to Ollama. Values shown are the compiled-in defaults.
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_URL=http://localhost:11434/api/embed
OLLAMA_EMBED_PREFIX=classification: 

# ---------------------------------------------------------------------------
# Telemetry source selection
# ---------------------------------------------------------------------------

# "synthetic" (default) runs the in-process sinusoid stub.
# "csv" replays TELEMETRY_CSV_PATH row-by-row (canonical header only).
TELEMETRY_SOURCE=synthetic

# Absolute path to a canonical telemetry CSV with the header:
#   timestamp_ms,gpu_temp_c,gpu_power_w,cpu_tctl_c,cpu_package_power_w
# Required when TELEMETRY_SOURCE=csv. No built-in default: if unset while
# TELEMETRY_SOURCE=csv, the runner warns and stamps source=synthetic_fallback.
TELEMETRY_CSV_PATH=

# ---------------------------------------------------------------------------
# Run profile
# ---------------------------------------------------------------------------

# Prompt profile slug. Currently only "math_logic" is wired up.
PROMPT_PROFILE=math_logic

# Optional model family override. One of:
#   olmoe | qwen3moe | gemma4 | deepseek2 | llama_moe
# Leave blank to let Router::probe_model infer it from the checkpoint.
MODEL_FAMILY=

# SAAQ update rule that fills the legacy latent-CSV columns.
# Either "saaq_v1_5" (default) or "legacy" / "saaq_v1_0".
# Both rules are always emitted in the dual-SAAQ columns regardless.
SAAQ_RULE=saaq_v1_5

# Per-run tick count. Special case: TICKS=0 with TELEMETRY_SOURCE=csv uses the
# exact CSV row count (one full loop, no wraparound contamination).
TICKS=512

# Repeats per (model, telemetry) tuple.
REPEAT_COUNT=1

# ---------------------------------------------------------------------------
# Artifact output root
# ---------------------------------------------------------------------------

# Where saaq_latent_calibration writes per-run artifact trees. Default is
# `./artifacts` (repo-relative). Set to an absolute path to redirect runs
# into an external consumer (e.g. Surrogate_Viz.jl).
VALIDATION_OUTPUT_ROOT=

# ---------------------------------------------------------------------------
# telemetry_bridge example knobs
# ---------------------------------------------------------------------------

# "dense" | "stub" | anything else => spiking (default).
ROUTING_MODE=spiking

# Projector strategy for SAAQ / telemetry_bridge. One of:
#   RateSum | TemporalHistogram | MembraneSnapshot | SpikingTernary
# Also accepts snake_case / kebab-case (rate_sum, temporal_histogram, ...).
# Unset / blank => SpikingTernary. Unrecognised values fail fast (exit 1)
# rather than silently falling back — a typed PROJECTION_MODE=RateSum must
# actually select RateSum (GH#162).
# Stamped onto run_manifest.json and summary.json as projection_mode.
PROJECTION_MODE=

# ---------------------------------------------------------------------------
# Campaign controls
# ---------------------------------------------------------------------------

# Path to a TOML lineup file listing MoE checkpoints
# (see configs/local_gguf_lineup.template.toml). When set, takes precedence over
# CHECKPOINT_PATH and over machine-local autodiscovery.
# A path that cannot be read or parsed is a hard error, not a fallback.
LINEUP_CONFIG=

# Optional free-form tag appended to every run_id and stamped into
# run_manifest.json / summary.json. Must match [A-Za-z0-9._-]; other
# characters are replaced with '_'. Leave blank to disable (no suffix,
# no trailing underscore).
RUN_TAG=

# When REPEAT_COUNT>=2 and this is true, the calibration runner
# byte-compares each repeat's latent_telemetry.csv to repeat 0 per
# (model_slug, telemetry_source, saaq_rule) group. Any
# mismatch stamps summary.json with repeat_determinism="mismatch" and the
# process exits non-zero. Default false.
STRICT_REPEAT_CHECK=false

# ---------------------------------------------------------------------------
# Lineups and run gates read by the example binaries
# ---------------------------------------------------------------------------

# Absolute path to a cloud lineup TOML (see configs/saaq_cloud_lineup.toml).
# Read by examples/support::cloud_lineup_path_from_env. Validated at config
# load time even when a higher-precedence lineup is the one actually used.
CLOUD_LINEUP_CONFIG=

# Tick count for the gpu_smoke_test example. Defaults to the compiled-in value.
GPU_SMOKE_TICKS=

# Set to 1 to allow RunMatrix::validate to accept Grok-1 matrix entries.
# This is a readiness flag, not a path.
GROK1_ARTIFACT_READY=

# Observability self-test mode, read by examples/support/observability.rs.
# Leave unset for normal runs.
OBSERVABILITY_PROBE_MODE=
